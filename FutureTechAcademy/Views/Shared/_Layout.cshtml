<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FutureTech Academy</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-dark: #020617;
                --accent-cyan: #06b6d4;
                --border-color: rgba(255, 255, 255, 0.1);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-dark);
                color: #ffffff;
            }

            /* Dark Modern Navbar */
            .navbar {
                border-bottom: 1px solid var(--border-color);
                background: rgba(2, 6, 23, 0.8) !important;
                backdrop-filter: blur(10px);
            }

            .navbar-brand {
                font-weight: 800;
                color: #ffffff !important;
                letter-spacing: -1px;
                font-size: 1.25rem;
            }

            .nav-link {
                color: #94a3b8 !important;
                font-size: 0.9rem;
                transition: 0.3s;
            }

                .nav-link:hover {
                    color: var(--accent-cyan) !important;
                }

            /* Minimalist Logout Button */
            .btn-logout {
                border-radius: 8px;
                border: 1px solid var(--border-color);
                color: #ffffff;
                font-size: 0.8rem;
                padding: 6px 16px;
                transition: 0.3s;
            }

                .btn-logout:hover {
                    background: rgba(255,255,255,0.05);
                    border-color: #ef4444;
                    color: #ef4444;
                }

            footer {
                background: var(--bg-dark);
                border-top: 1px solid var(--border-color);
                color: #64748b;
                padding: 40px 0;
            }

            .tracking-widest {
                letter-spacing: 0.1em;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg py-3 sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill text-info me-2"></i>FUTURETECH
                </a>

                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Students" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i> Management
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <span class="text-info small fw-bold">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </span>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-logout">Logout</button>
                                </form>
                            </div>
                        }
                        @* Admin Access button removed here. Unauthenticated users will now use the buttons on the Home page. *@
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <p class="small mb-0 text-uppercase tracking-widest fw-bold">
                FutureTech Academy System &copy; @DateTime.Now.Year |
                <span class="text-info">Azure Cloud Secured</span>
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
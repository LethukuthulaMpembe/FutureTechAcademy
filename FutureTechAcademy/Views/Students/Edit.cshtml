@model FutureTechAcademy.Models.Student

@{
    ViewData["Title"] = "Update Identity";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-color: #020617;
        --card-bg: #0f172a;
        --accent-purple: #8b5cf6;
        --accent-cyan: #22d3ee;
        --text-high: #ffffff;
        --text-dim: #94a3b8;
        --border-color: rgba(255, 255, 255, 0.1);
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-high);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .identity-sidebar {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 30px;
    }

    .profile-asset-frame {
        width: 100%;
        aspect-ratio: 1/1;
        border-radius: 20px;
        border: 2px solid var(--border-color);
        overflow: hidden;
        background: rgba(0,0,0,0.3);
        margin-bottom: 25px;
    }

    .status-pill {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .status-active {
        background: rgba(34, 211, 238, 0.1);
        color: var(--accent-cyan);
        border: 1px solid var(--accent-cyan);
    }

    .status-inactive {
        background: rgba(244, 63, 94, 0.1);
        color: #f43f5e;
        border: 1px solid #f43f5e;
    }

    .id-terminal {
        background: rgba(0, 0, 0, 0.4);
        border-radius: 12px;
        padding: 15px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-dim);
        border-left: 3px solid var(--accent-purple);
    }

    .attributes-panel {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px;
    }

    .form-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--accent-cyan);
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .cyber-input {
        background: rgba(0, 0, 0, 0.2) !important;
        border: 1px solid var(--border-color) !important;
        color: white !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        font-weight: 500;
    }

    .btn-commit {
        background: var(--accent-cyan);
        color: #000 !important;
        border: none;
        padding: 14px 40px;
        border-radius: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
    }

        .btn-commit:hover {
            background: #ffffff;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">
    <div class="mb-5">
        <h2 class="fw-800 text-white" style="letter-spacing: -2px; font-size: 2.5rem;">Update <span class="text-info">Identity.</span></h2>
        <p class="text-dim small fw-bold mt-2">// SYSTEM_NODE_EDIT: AUTHORIZED</p>
    </div>

    <!-- CRITICAL FIX: Added enctype="multipart/form-data" -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <!-- HIDDEN FIELDS: These must be present to update the correct record -->
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProfileImageUrl" />

        <div class="row g-4">
            <!-- Left Column -->
            <div class="col-lg-4">
                <div class="identity-sidebar shadow-lg">
                    <p class="form-label text-center mb-3">Stored Media Asset</p>
                    <div class="profile-asset-frame">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Current Asset" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-dim opacity-50">
                                <i class="bi bi-person-bounding-box fs-1"></i>
                            </div>
                        }
                    </div>

                    <div class="text-center mb-4">
                        <span class="status-pill @(Model.EnrolmentStatus == "Active" ? "status-active" : "status-inactive")">
                            STATUS: @Model.EnrolmentStatus.ToUpper()
                        </span>
                    </div>

                    <div class="id-terminal">
                        <div class="text-truncate">UUID: @Model.Id</div>
                        <div>PROVIDER: COSMOS_DB_CORE</div>
                        <div class="mt-2 text-info">> DATA_INTEGRITY: VERIFIED</div>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-8">
                <div class="attributes-panel shadow-lg">
                    <h5 class="fw-800 text-white mb-4">Primary Attributes</h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control cyber-input" />
                            <span asp-validation-for="FirstName" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control cyber-input" />
                            <span asp-validation-for="LastName" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label asp-for="Email" class="form-label">System Email</label>
                        <input asp-for="Email" type="email" class="form-control cyber-input" />
                        <span asp-validation-for="Email" class="text-danger small fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="row g-4 mt-1">
                        <div class="col-md-6">
                            <label asp-for="MobileNumber" class="form-label">Contact Node</label>
                            <input asp-for="MobileNumber" class="form-control cyber-input" />
                            <span asp-validation-for="MobileNumber" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EnrolmentStatus" class="form-label">Status</label>
                            <select asp-for="EnrolmentStatus" class="form-select cyber-input">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-secondary">
                        <a asp-action="Index" class="text-dim text-decoration-none small fw-bold">
                            <i class="bi bi-arrow-left"></i> ABORT CHANGES
                        </a>
                        <button type="submit" class="btn-commit">
                            COMMIT UPDATES
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
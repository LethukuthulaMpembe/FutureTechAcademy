@{
    ViewData["Title"] = "Staff Registration";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <!-- Professional Monochromatic Border -->
            <div class="p-5 border border-dark bg-white shadow-sm">
                <h3 class="fw-bold mb-2" style="letter-spacing: -1px;">STAFF PROVISIONING</h3>
                <p class="text-muted small mb-4 text-uppercase" style="letter-spacing: 1px;">Internal Use Only</p>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-dark rounded-0 small mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Message
                    </div>
                }

                <form asp-controller="Account" asp-action="RegisterStaff" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="small fw-bold text-uppercase">First Name</label>
                        <input type="text" name="firstName" class="form-control rounded-0 border-dark shadow-none" required />
                    </div>

                    <div class="mb-3">
                        <label class="small fw-bold text-uppercase">Last Name</label>
                        <input type="text" name="lastName" class="form-control rounded-0 border-dark shadow-none" required />
                    </div>

                    <div class="mb-4">
                        <label class="small fw-bold text-uppercase">Corporate Email (Google)</label>
                        <input type="email" name="email" class="form-control rounded-0 border-dark shadow-none" placeholder="admin@futuretech.com" required />
                        <div class="form-text small">This email must be authorized for OAuth login.</div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 fw-bold mb-3 shadow">
                        REGISTER STAFF IDENTITY
                    </button>

                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark w-100 rounded-0 py-2 small">
                        CANCEL
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "FutureTech Academy | Administrative Gateway";
}

<!-- Premium Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --bg-main: #020617;
        --card-bg: #0f172a;
        --accent-purple: #8b5cf6;
        --accent-cyan: #22d3ee;
        --text-high: #f8fafc;
        --text-dim: #94a3b8;
        --border-color: rgba(255, 255, 255, 0.1);
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-high);
        font-family: 'Plus Jakarta Sans', sans-serif;
        line-height: 1.6;
    }

    /* Gradient Background Effect */
    .hero-glow {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 800px;
        background: radial-gradient(circle at 50% 0%, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
        z-index: -1;
    }

    .hero-section {
        padding: 6rem 0 4rem 0;
    }

    .main-title {
        font-size: 4rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .gradient-text {
        background: linear-gradient(90deg, var(--accent-purple), var(--accent-cyan));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Buttons */
    .btn-gate {
        padding: 16px 36px;
        border-radius: 12px;
        font-weight: 700;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-auth {
        background: var(--text-high);
        color: var(--bg-main) !important;
    }

        .btn-auth:hover {
            background: var(--accent-cyan);
            transform: translateY(-3px);
        }

    /* Architecture Visualization Card */
    .infra-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 30px;
        height: 100%;
        transition: 0.3s;
    }

        .infra-card:hover {
            border-color: var(--accent-purple);
        }

    .code-snippet {
        background: #000;
        padding: 20px;
        border-radius: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #4ade80;
        border-left: 3px solid var(--accent-cyan);
    }

    .feature-list {
        list-style: none;
        padding: 0;
    }

        .feature-list li {
            margin-bottom: 12px;
            font-size: 0.9rem;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .feature-list i {
            color: var(--accent-cyan);
        }

    .status-badge {
        font-size: 0.65rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 6px 12px;
        border-radius: 6px;
        background: rgba(34, 211, 238, 0.1);
        color: var(--accent-cyan);
        border: 1px solid rgba(34, 211, 238, 0.2);
    }
</style>

<div class="hero-glow"></div>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="mb-4">
                    <span class="status-badge">Secure Administrative Node v1.0</span>
                </div>
                <h1 class="main-title">FutureTech <span class="gradient-text">Student Core.</span></h1>
                <p class="lead text-dim mb-5" style="max-width: 600px;">
                    A highly scalable, cloud-native student management system built on .NET Core.
                    Authorized access only via OAuth 2.0 protocol. Integrating Azure Cosmos DB
                    for record persistence and Azure Blob Storage for secure media handling.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-5" style="position: relative; z-index: 10;">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-gate btn-auth">
                            <i class="bi bi-shield-lock-fill"></i> INITIALIZE OAUTH LOGIN
                        </a>
                        <a href="#architecture" class="btn-gate border border-secondary text-white">
                            SYSTEM ARCHITECTURE
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Students" asp-action="Index" class="btn-gate btn-auth">
                            <i class="bi bi-speedometer2"></i> ADMIN DASHBOARD
                        </a>
                    }
                </div>

                <div class="d-flex gap-4 align-items-center opacity-75">
                    <span class="small text-dim">AUTH PROVIDERS:</span>
                    <i class="bi bi-google text-white fs-5" title="Google"></i>
                    <i class="bi bi-github text-white fs-5" title="GitHub"></i>
                    <i class="bi bi-fire text-white fs-5" title="Firebase"></i>
                </div>
            </div>

            <!-- Visual Component: Data Structure -->
            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="infra-card">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="small fw-bold text-uppercase">Cosmos DB Schema</span>
                        <span class="text-dim small">NoSQL Document</span>
                    </div>
                    <div class="code-snippet shadow-lg">
                        { <br />
                        &nbsp;&nbsp;"id": "FT-8842",<br />
                        &nbsp;&nbsp;"firstName": "John",<br />
                        &nbsp;&nbsp;"enrolment": "Active",<br />
                        &nbsp;&nbsp;"profileImg": "sas_token_enabled",<br />
                        &nbsp;&nbsp;"meta": "encrypted_azure_core"<br />
                        }
                    </div>
                    <div class="mt-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="spinner-grow spinner-grow-sm text-info"></div>
                            <span class="small">Syncing with Azure Blob Storage...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Detailed Modules Section -->
<section id="architecture" class="py-5 bg-black bg-opacity-25">
    <div class="container py-5">
        <div class="row g-4">
            <!-- Module 1: Management -->
            <div class="col-md-4">
                <div class="infra-card">
                    <i class="bi bi-person-badge fs-2 text-purple mb-3"></i>
                    <h5 class="fw-bold">Student Management</h5>
                    <ul class="feature-list mt-3">
                        <li><i class="bi bi-check2-circle"></i> Full CRUD Operations</li>
                        <li><i class="bi bi-check2-circle"></i> Soft-Delete Functionality</li>
                        <li><i class="bi bi-check2-circle"></i> Server-side Pagination</li>
                        <li><i class="bi bi-check2-circle"></i> Dynamic Search (Name/ID)</li>
                    </ul>
                </div>
            </div>

            <!-- Module 2: File Handling -->
            <div class="col-md-4">
                <div class="infra-card">
                    <i class="bi bi-cloud-arrow-up fs-2 text-cyan mb-3"></i>
                    <h5 class="fw-bold">Secure Blob Storage</h5>
                    <ul class="feature-list mt-3">
                        <li><i class="bi bi-lock"></i> AES-256 Media Encryption</li>
                        <li><i class="bi bi-key"></i> Shared Access Signatures (SAS)</li>
                        <li><i class="bi bi-image"></i> Automatic Image Resizing</li>
                        <li><i class="bi bi-shield-check"></i> Expiring Media Links</li>
                    </ul>
                </div>
            </div>

            <!-- Module 3: DevOps -->
            <div class="col-md-4">
                <div class="infra-card">
                    <i class="bi bi-gear-wide-connected fs-2 text-info mb-3"></i>
                    <h5 class="fw-bold">Azure Deployment</h5>
                    <ul class="feature-list mt-3">
                        <li><i class="bi bi-layers"></i> Deployment Slots (A/B Testing)</li>
                        <li><i class="bi bi-graph-up"></i> Application Insights Analytics</li>
                        <li><i class="bi bi-infinity"></i> CI/CD Pipeline Ready</li>
                        <li><i class="bi bi-cpu"></i> Elastic Auto-scaling</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Compliance & Testing Footer -->
<footer class="py-5 border-top border-secondary">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h6 class="fw-bold text-uppercase small text-dim mb-3">Quality Assurance & Security</h6>
                <div class="d-flex gap-3 flex-wrap">
                    <span class="badge bg-dark border border-secondary p-2">Unit Testing: XUnit</span>
                    <span class="badge bg-dark border border-secondary p-2">Security: OAuth 2.0</span>
                    <span class="badge bg-dark border border-secondary p-2">DB: Cosmos NoSQL</span>
                </div>
            </div>
            <div class="col-lg-6 text-lg-end mt-4 mt-lg-0">
                <p class="small text-dim mb-0">
                    &copy; @DateTime.Now.Year FutureTech Academy IT Department.<br />
                    System monitored by Azure Security Center. <br />
                    Template approved by CQPA & AEM.
                </p>
            </div>
        </div>
    </div>
</footer>